# Copy to .env and fill in from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# Leave them empty to run the app in demo mode.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: Firebase console -> Authentication -> Sign-in method -> Google ->
# "Web SDK configuration" -> Web client ID (ends in .apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# TESTING ONLY (leave empty for the normal random draw): force the game(s) the host's rounds use.
# One game id, or several separated by commas to play them in that order. Ids:
# wordle, human-calculator, magical-banana, fortune, hangman, schulte-table, inversion,
# janken-negotiation, battleships, maze-hopscotch, karuta
# Restart with `npx expo start --web -c` after changing it. On the web you can also add
# ?testGame=magical-banana to the address instead (no restart needed).
EXPO_PUBLIC_TEST_GAME=
