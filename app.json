{
  "expo": {
    "name": "Wonderland",
    "slug": "wonderland-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "WONDERLAND uses the microphone for voice chat with the players in your lobby.",
        "UIBackgroundModes": ["audio"]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0416",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wonderlandgame.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "WONDERLAND uses the microphone for voice chat with the players in your lobby."
        }
      ],
      "./plugins/withWebrtcProguard"
    ],
    "extra": {
      "eas": {
        "projectId": "c36e7f94-ca22-4cfc-8aa3-c1a93b974967"
      }
    },
    "owner": "nagiiiqt",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c36e7f94-ca22-4cfc-8aa3-c1a93b974967"
    }
  }
}